          "def": 0.3,
          "min": 0,
          "max": 0.6
        },
        {
          "id": "maxDistance",
          "kind": "range",
          "label": "Max offset",
          "def": 12,
          "unit": "px",
          "min": 0,
          "max": 24
        },
        {
          "id": "radius",
          "kind": "range",
          "label": "Trigger radius",
          "def": 1.6,
          "unit": "倍",
          "min": 1,
          "max": 3
        },
        {
          "id": "duration",
          "kind": "range",
          "label": "Return duration",
          "def": 350,
          "unit": "ms",
          "min": 150,
          "max": 600
        }
      ],
      "loop": "manual",
      "prompt": {
        "zh": "做一个磁吸按钮（magnetic button）：监听容器的 pointermove，用 getBoundingClientRect 算出按钮中心，指针进入按钮宽高 1.6 倍范围内时，让按钮朝指针方向偏移，偏移量 = 指针到中心的距离 × 0.30，并限制在 12px 以内；指针离开就复位，复位过渡 350ms cubic-bezier(0.22, 1, 0.36, 1)。用 transform: translate3d 移动，pointermove 里用 requestAnimationFrame 节流。系统减少动态效果时完全不跟随。",
        "en": "magnetic button, pointermove + getBoundingClientRect, offset = (pointer - center) * 0.30, clamp to 12px, activation radius 1.6x button size, return with transition 350ms cubic-bezier(0.22, 1, 0.36, 1), transform: translate3d, throttle with requestAnimationFrame, disable under prefers-reduced-motion"
      },
      "detail": {
        "page": "https://publieople.github.io/design-museum/entry/magnetic-button/",
        "markdown": "https://publieople.github.io/design-museum/catalog.md#magnetic-button"
      }
    },
