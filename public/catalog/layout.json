    {
      "slug": "sticky-header",
      "code": "L-01",
      "url": "https://publieople.github.io/design-museum/entry/sticky-header/",
      "category": "layout",
      "nameZh": "粘性头部",
      "nameEn": "Sticky Header",
      "aliases": [
        "吸顶导航",
        "固定顶栏",
        "滚动吸顶",
        "sticky nav",
        "fixed header",
        "hide on scroll"
      ],
      "oneLiner": "页面滚动时头部留在顶部，常配合「下滑隐藏、上滑出现」。",
      "oneLinerEn": "A page header that stays pinned on scroll, often hiding as you scroll down and revealing itself as you scroll up.",
      "keywords": [
        "position: sticky",
        "scroll direction",
        "hide on scroll down",
        "sticky nav",
        "will-change: transform"
      ],
      "related": [
        "sticky-stack",
        "frosted-glass",
        "scroll-snap"
      ],
      "scenes": [
        "nav",
        "page",
        "scroll"
      ],
      "feel": [
        "calm",
        "crisp"
      ],
      "intent": [
        "affordance"
      ],
      "tags": [
        "js",
        "scroll-linked",
        "composited",
        "stable"
      ],
      "demo": {
        "shape": "scroll",
        "thumb": "still"
      },
      "controls": [
        {
          "id": "threshold",
          "kind": "range",
          "label": "Stick threshold",
          "def": 60,
          "unit": "px",
          "min": 0,
          "max": 200
        },
        {
          "id": "hide",
          "kind": "toggle",
          "label": "Hide on scroll down",
          "def": true
        },
        {
          "id": "blur",
          "kind": "range",
          "label": "Background blur after sticking",
          "def": 8,
          "unit": "px",
          "min": 0,
          "max": 20
        }
      ],
      "loop": "manual",
      "prompt": {
        "zh": "做粘性头部（sticky header）：用 position: sticky; top: 0 吸顶，滚动超过 60px 后给头部加半透明底色和 backdrop-filter: blur(8px) 与一条下边框。向下滚动时用 transform: translateY(-100%) 收起头部，向上滚动立刻显示，判定用当前 scrollY 与上一次 scrollY 比较，动画 250ms ease-out。",
        "en": "sticky header, position: sticky; top: 0, add backdrop-filter: blur(8px) and border-bottom after 60px scroll, hide on scroll down / reveal on scroll up via transform: translateY(-100%) with 250ms ease-out, compare current vs previous scrollY, animate transform only, throttle scroll handler with requestAnimationFrame"
      },
      "detail": {
        "page": "https://publieople.github.io/design-museum/entry/sticky-header/",
        "markdown": "https://publieople.github.io/design-museum/catalog.md#sticky-header"
      }
    },
