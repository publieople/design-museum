{
  "name": "design-museum",
  "private": true,
  "version": "0.0.0",
  "description": "把说不出口的前端效果做成可交互标本：40 条中英术语对照、参数可调、一键复制成给 AI 的设计需求。",
  "license": "MIT",
  "author": "publieople",
  "repository": {
    "type": "git",
    "url": "https://github.com/publieople/design-museum.git"
  },
  "homepage": "https://publieople.github.io/design-museum/",
  "packageManager": "pnpm@11.28.3",
  "engines": {
    "node": ">=22"
  },
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && node scripts/gen-catalog.mjs && vite build && node scripts/prerender.mjs",
    "lint": "oxlint",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "gen:meta": "node scripts/gen-entry-meta.mjs",
    "gen:catalog": "node scripts/gen-catalog.mjs",
    "prerender": "node scripts/prerender.mjs",
    "new:entry": "node scripts/new-entry.mjs",
    "find:entry": "node scripts/find-entry.mjs",
    "check": "pnpm typecheck && pnpm lint && pnpm test",
    "test": "vitest run",
    "test:watch": "vitest",
    "validate": "vitest run src/data",
    "screenshots": "node scripts/screenshots.mjs"
  },
  "dependencies": {
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource-variable/space-grotesk": "^5.3.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "oxlint": "^1.81.0",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.2",
    "vite": "^8.3.0",
    "vitest": "^5.0.3"
  }
}
