{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["react", "typescript", "oxc"],
  "rules": {
    "react/rules-of-hooks": "error",
    "react/only-export-components": [
      "warn",
      {
        "allowConstantExport": true,
        "allowExportNames": [
          "setServerRoute",
          "parseRoute",
          "useRoute",
          "isPathChange",
          "navigate",
          "normalizeLegacyHash",
          "useQueryUpdater",
          "loadPrefs",
          "applyPrefs",
          "usePrefs",
          "PREF_DEFAULTS",
          "useToast"
        ]
      }
    ]
  }
}
